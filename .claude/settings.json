{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm *)",
      "Bash(npx shadcn@4.22.1 *)",
      "Bash(npx vercel *)",
      "Bash(npx --yes vercel *)",
      "Bash(node *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(uname *)",
      "Bash(xcode-select *)",
      "Bash(curl -fsSL https://nodejs.org/*)",
      "Bash(curl -fsSIL https://github.com/cli/cli/*)",
      "Bash(curl -fsSL -o * https://nodejs.org/*)",
      "Bash(curl -fsSL -o * https://github.com/cli/cli/*)",
      "Bash(open *.pkg)",
      "Bash(open https://*)",
      "Bash(open \"https://*)",
      "Bash(open http://localhost*)",
      "Bash(open \"http://localhost*)",
      "Bash(start \"\" *)",
      "Bash(curl -s -o /dev/null -w * http://localhost*)",
      "Bash(curl -s http://localhost*)",
      "Bash(curl -s * http://localhost*)",
      "PowerShell(winget install *)",
      "PowerShell(winget --version)",
      "PowerShell(git *)",
      "PowerShell(node *)",
      "PowerShell(npm *)",
      "PowerShell(gh *)",
      "PowerShell(Start-Process https://*)",
      "PowerShell(Start-Process \"https://*)",
      "PowerShell(Start-Process http://localhost*)",
      "PowerShell(Start-Process \"http://localhost*)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:github.com)",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_migrations",
      "mcp__supabase__list_extensions",
      "mcp__supabase__get_project_url",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__generate_typescript_types",
      "mcp__supabase__get_advisors",
      "mcp__supabase__search_docs",
      "mcp__supabase__list_projects",
      "mcp__supabase__get_project",
      "mcp__supabase__list_organizations",
      "mcp__supabase__get_organization",
      "mcp__supabase__get_cost"
    ],
    "deny": [
      "mcp__Claude_Browser",
      "mcp__claude-in-chrome",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard origin*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "PowerShell(Remove-Item * -Recurse *C:\\*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.*.local)"
    ]
  }
}
